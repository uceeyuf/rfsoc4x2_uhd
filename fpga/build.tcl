#
# RFSoC 4x2 UHD FPGA build (Vivado 2023.2, non-project mode).
#
#   vivado -mode batch -source fpga/build.tcl -tclargs <step> [jobs]
#     step: rtl   (RTL elaboration only, quick check)
#           synth | impl (synth + place/route + bitstream + XSA)
#
# Inputs (generated by fpga/build.sh before Vivado starts):
#   build/image_core/      rfnoc_image_core.{sv,vh}, Makefile.inc (image builder)
#   build/design_srcs.txt  X440 HDL source list of the upstream makefiles
#   build/image_defs.txt   image core Verilog defines
# Output: build/rfsoc4x2/ (checkpoints, reports, rfsoc4x2.bit, rfsoc4x2.xsa)
#

set step [lindex $argv 0]
set jobs [expr {[llength $argv] > 1 ? [lindex $argv 1] : 4}]
set root [file normalize [file join [file dirname [info script]] ..]]
set part xczu48dr-ffvg1517-2-e
set top  rfsoc4x2
set x400 $root/uhd/fpga/usrp3/top/x400
set ic   $root/build/image_core
set out  $root/build/rfsoc4x2
set tools $root/fpga/tools

file mkdir $out
cd $out
set_param general.maxThreads $jobs
set_param messaging.defaultLimit 10000
create_project -in_memory -part $part
set_property source_mgmt_mode All [current_project]

proc read_lines {f} {
  set fh [open $f r]; set l [split [string trim [read $fh]] "\n"]; close $fh
  return $l
}

# ---------------------------------------------------------------------------
# Block designs: upstream X4xx Tcl, retargeted to this Vivado and part
# ---------------------------------------------------------------------------
proc build_bd {bd_name tcl hdl} {
  global out
  if {$hdl ne ""} { source $hdl }
  create_bd_design -dir $out/bd $bd_name
  # the BD scripts run in this scope; keep the design name out of their way
  set ::build_bd_name $bd_name
  source $tcl
  set bd_name $::build_bd_name
  validate_bd_design
  save_bd_design
  set f [get_files $bd_name.bd]
  set_property synth_checkpoint_mode None $f
  generate_target all $f
  close_bd_design [get_bd_designs $bd_name]
}

file mkdir $out/bd_tcl
set ipdir $x400/ip
foreach bd {eth_100g_bd axi_eth_dma_bd axi_interconnect_eth_bd axi_interconnect_dma_bd axi_interconnect_app_bd} {
  exec python3 $tools/bd_retarget.py $ipdir/$bd/$bd.tcl $out/bd_tcl/$bd.tcl --part $part
  set hdl ""
  if {[file exists $ipdir/$bd/hdl_sources.tcl]} { set hdl $ipdir/$bd/hdl_sources.tcl }
  build_bd $bd $out/bd_tcl/$bd.tcl $hdl
}
set x440bd $ipdir/x4xx_ps_rfdc_bd/x440_ps_rfdc_bd
exec python3 $tools/bd_retarget.py $x440bd/x440_ps_rfdc_bd.tcl $out/bd_tcl/x440_ps_rfdc_bd.tcl \
  --part $part --rfsoc4x2
set ::env(X440_BD_TCL) $out/bd_tcl/x440_ps_rfdc_bd.tcl
build_bd rfsoc4x2_ps_rfdc_bd $root/fpga/ip/rfsoc4x2_ps_rfdc_bd/rfsoc4x2_ps_rfdc_bd.tcl \
  $x440bd/hdl_sources.tcl

# ---------------------------------------------------------------------------
# HDL sources: the X440 list with rfsoc4x2.sv in place of x4xx.sv; IP (.xci),
# upstream BDs and upstream constraints are not used
# ---------------------------------------------------------------------------
set srcs [read_lines $root/build/design_srcs.txt]
lappend srcs $root/fpga/rfsoc4x2.sv
set incdirs [list $x400 $ic]
foreach f $srcs {
  if {[string match */x400/x4xx.sv $f]} continue
  set e [file extension $f]
  if {[lsearch {.xci .bd .xdc .sdc} $e] >= 0} continue
  # outputs of the upstream IP build (10 GbE PCS/PMA wrappers): not built here
  if {![file exists $f]} { puts "BUILDER: skipping missing $f"; continue }
  lappend incdirs [file dirname $f]
  switch -- $e {
    .vhd     { read_vhdl -vhdl2008 -library work $f }
    .v - .vh { read_verilog $f }
    .sv - .svh { read_verilog -sv $f }
    .edif    { read_edif $f }
  }
}
set incdirs [lsort -unique $incdirs]

read_xdc $root/fpga/constraints/pins/rfsoc4x2.xdc
read_xdc $root/fpga/constraints/timing/rfsoc4x2.xdc

set git_hash [string range [exec git -C $root rev-parse HEAD] 0 7]
set defs [list X440=1 RFNOC_IMAGE_CORE_HDR=$ic/rfnoc_image_core.vh \
               UHD_FPGA_DIR=$root/uhd/fpga GIT_HASH=32'h$git_hash]
foreach d [split [string trim [read [open $root/build/image_defs.txt]]] " "] {
  if {$d ne ""} { lappend defs $d }
}
puts "BUILDER: defines: $defs"

# ---------------------------------------------------------------------------
# Synthesis
# ---------------------------------------------------------------------------
if {$step eq "rtl"} {
  synth_design -rtl -top $top -part $part -include_dirs $incdirs -verilog_define $defs
  puts "BUILDER: RTL elaboration done"
  exit
}
synth_design -top $top -part $part -include_dirs $incdirs -verilog_define $defs
write_checkpoint -force $out/post_synth.dcp
report_utilization -file $out/post_synth_util.rpt
report_timing_summary -file $out/post_synth_timing.rpt
puts "BUILDER: synthesis done"
if {$step eq "synth"} { exit }

# ---------------------------------------------------------------------------
# Implementation, bitstream, XSA
# ---------------------------------------------------------------------------
opt_design
place_design -directive ExtraNetDelay_high
phys_opt_design
route_design
phys_opt_design
write_checkpoint -force $out/post_route.dcp
report_utilization -file $out/post_route_util.rpt
report_timing_summary -file $out/post_route_timing.rpt
set wns [get_property SLACK [get_timing_paths -max_paths 1 -nworst 1 -setup]]
puts "BUILDER: post-route WNS $wns"
set_property BITSTREAM.CONFIG.USR_ACCESS TIMESTAMP [current_design]
write_bitstream -force -bin_file $out/$top.bit
write_hw_platform -fixed -include_bit -force $out/$top.xsa
puts "BUILDER: implementation done"
