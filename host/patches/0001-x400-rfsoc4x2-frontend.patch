@@ -0,0 +1,148 @@
+//
+// Copyright 2026 Yijie Yu
+//
+// SPDX-License-Identifier: GPL-3.0-or-later
+//
+// RFSoC 4x2 direct-sampling front end for the X4xx radio control.
+//
+// The RFSoC 4x2 has no daughterboards: the converters connect to the SMA ports
+// through baluns. The FPGA image keeps the X440 structure, 4 ports per radio
+// (identity RFDC mapping): RX ports 0/1 and TX port 0 are the bonded
+// converters, the other ports are converters that are not bonded out ("NC").
+// Tuning is the RFDC NCO (fine mixer), set through MPM; there are no LOs,
+// gains, filters or antenna switches.
+//
+
+#pragma once
+
+#include <uhdlib/usrp/dboard/debug_dboard.hpp>
+#include <array>
+#include <string>
+
+namespace uhd { namespace rfnoc {
+
+//! PID that MPM (rfsoc4x2.py) reports for the RFSoC 4x2 front ends
+const static uint16_t RFSOC4X2_DB_PID = 0x4F42;
+
+class rfsoc4x2_dboard_impl : public debug_dboard_common_impl
+{
+public:
+    rfsoc4x2_dboard_impl(const size_t db_idx,
+        const std::string& unique_id,
+        std::shared_ptr<mpmd_mb_controller> mb_controller,
+        uhd::property_tree::sptr tree)
+        : _unique_id(unique_id), _db_idx(db_idx), _tree(tree)
+    {
+        _num_chans = NUM_CHANS;
+        UHD_ASSERT_THROW(mb_controller);
+        _rpcc = mb_controller->get_rpc_client();
+        UHD_ASSERT_THROW(_rpcc);
+        _conv_rate = _rpcc->get_dboard(_db_idx).get_dboard_sample_rate();
+        _init_frontend_subtree();
+    }
+
+    double get_converter_rate() const override
+    {
+        return _conv_rate;
+    }
+
+    // Antennas: the board labels of the bonded converters
+    std::string get_rx_antenna(const size_t chan) const override
+    {
+        return RX_LABELS.at(_db_idx).at(chan);
+    }
+    std::vector<std::string> get_rx_antennas(const size_t chan) const override
+    {
+        return {get_rx_antenna(chan)};
+    }
+    std::string get_tx_antenna(const size_t chan) const override
+    {
+        return TX_LABELS.at(_db_idx).at(chan);
+    }
+    std::vector<std::string> get_tx_antennas(const size_t chan) const override
+    {
+        return {get_tx_antenna(chan)};
+    }
+
+    // Frequency: RFDC NCO
+    double set_rx_frequency(const double freq, const size_t chan) override
+    {
+        return _rx_freq.at(chan) = _set_nco("rx", freq, chan);
+    }
+    double get_rx_frequency(const size_t chan) override
+    {
+        return _rx_freq.at(chan);
+    }
+    freq_range_t get_rx_frequency_range(const size_t) const override
+    {
+        return freq_range_t(0.0, _conv_rate);
+    }
+    double set_tx_frequency(const double freq, size_t chan) override
+    {
+        return _tx_freq.at(chan) = _set_nco("tx", freq, chan);
+    }
+    double get_tx_frequency(const size_t chan) override
+    {
+        return _tx_freq.at(chan);
+    }
+    freq_range_t get_tx_frequency_range(const size_t) const override
+    {
+        return freq_range_t(0.0, _conv_rate);
+    }
+
+private:
+    static constexpr size_t NUM_CHANS = 4;
+
+    // [radio][channel]; radio0 = ADC tiles 224 (/225) / DAC tiles 228 (/229),
+    // radio1 = ADC tiles 226 (/227) / DAC tiles 230 (/231) (RFSoC 4x2 reference
+    // manual labels; NC = not bonded out)
+    const std::array<std::array<std::string, NUM_CHANS>, 2> RX_LABELS = {
+        {{"ADC_D", "ADC_C", "NC", "NC"}, {"ADC_B", "ADC_A", "NC", "NC"}}};
+    const std::array<std::array<std::string, NUM_CHANS>, 2> TX_LABELS = {
+        {{"DAC_B", "NC", "NC", "NC"}, {"DAC_A", "NC", "NC", "NC"}}};
+
+    double _set_nco(const std::string& trx, const double freq, const size_t chan)
+    {
+        const double nco = _rpcc->get_dboard(_db_idx).rfdc_set_nco_freq(
+            trx, chan, freq, static_cast<uint32_t>(ch_mode::REAL));
+        RFNOC_LOG_DEBUG(trx << " chan " << chan << ": NCO " << nco / 1e6 << " MHz");
+        return nco;
+    }
+
+    void _init_frontend_subtree()
+    {
+        auto subtree = _tree->subtree(fs_path("dboard"));
+        for (size_t chan = 0; chan < NUM_CHANS; chan++) {
+            for (const std::string trx : {"rx", "tx"}) {
+                const fs_path fe_path =
+                    fs_path(trx + "_frontends") / std::to_string(chan);
+                const std::string antenna =
+                    trx == "rx" ? get_rx_antenna(chan) : get_tx_antenna(chan);
+                subtree->create<std::string>(fe_path / "name")
+                    .set("RFSoC4x2 " + antenna);
+                subtree->create<std::vector<std::string>>(fe_path / "antenna" / "options")
+                    .set({antenna});
+                subtree->create<meta_range_t>(fe_path / "freq" / "range")
+                    .set(freq_range_t(0.0, _conv_rate));
+                subtree->create<meta_range_t>(fe_path / "gains" / "all" / "range")
+                    .set(gain_range_t(0.0, 0.0, 1.0));
+                subtree->create<std::string>(fe_path / "connection").set("IQ");
+            }
+        }
+    }
+
+    const std::string _unique_id;
+    const size_t _db_idx;
+    uhd::property_tree::sptr _tree;
+    uhd::rpc_client::sptr _rpcc;
+    double _conv_rate = 0.0;
+    std::array<double, NUM_CHANS> _rx_freq{};
+    std::array<double, NUM_CHANS> _tx_freq{};
+
+    const std::string& get_unique_id() const
+    {
+        return _unique_id;
+    }
+};
+
+}} // namespace uhd::rfnoc
