# RFSoC 4x2 eth0: GEM1, 1 GbE. Fixed, locally administered MAC: the board has no
# EEPROM (X4xx reads the MACs from it through nvmem), nixge ignores
# local-mac-address and U-Boot picks a random one for GEM1 on every boot.
[Match]
Path=platform-ff0c0000.ethernet

[Link]
MACAddress=02:4a:58:00:00:00
