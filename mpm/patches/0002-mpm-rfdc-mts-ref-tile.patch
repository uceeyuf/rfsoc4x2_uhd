+void rfdc_ctrl::set_sync_ref_tile(uint32_t tile_index, converter_options conv_option)
+{
+    XRFdc_MultiConverter_Sync_Config* sync_config = conv_option ? &rfdc_dac_sync_config
+                                                                : &rfdc_adc_sync_config;
+    sync_config->RefTile = tile_index;
+}
