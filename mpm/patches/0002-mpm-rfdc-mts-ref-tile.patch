+     * @param tile_index the reference tile
+     * @param conv_option the converter type (ADC or DAC)
+     */
+    void set_sync_ref_tile(uint32_t tile_index, converter_options conv_option);
+
+    /**
      * Get post-sync offset between ADC or DAC tile and reference tile
